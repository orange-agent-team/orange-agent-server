{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orange:skill-template:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "scenario",
    "name",
    "instruction",
    "tools"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(orange|local)[.][a-z0-9][a-z0-9.-]*$",
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"
    },
    "scenario": {
      "type": "string",
      "pattern": "^AU-[0-9]{2}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "tools": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "read_file",
          "list_directory",
          "search_files",
          "search_text",
          "apply_patch"
        ]
      }
    }
  },
  "$defs": {
    "SkillPin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(orange|local)[.][a-z0-9][a-z0-9.-]*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ]
    },
    "SourceReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "start_byte": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "end_byte": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "line": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "required": [
        "path",
        "sha256",
        "start_byte",
        "end_byte"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tools": {
            "contains": {
              "const": "apply_patch"
            }
          }
        }
      },
      "then": {
        "properties": {
          "id": {
            "const": "orange.reviewed-patch"
          }
        }
      }
    }
  ]
}
