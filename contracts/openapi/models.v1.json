{
  "openapi": "3.1.0",
  "info": {
    "title": "Orange reviewed market models",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/models": {
      "get": {
        "operationId": "listReviewedMarketModels",
        "security": [
          {
            "UserSession": []
          }
        ],
        "description": "Lists currently eligible development text offers matched to licensed, pinned weights. A listing does not reserve capacity or freeze a quote. Exposure requires a configured artifact service. Other modalities have independent local and consent-qualified paths.",
        "responses": {
          "200": {
            "description": "Current snapshot. Empty data means there is no matching admitted live offer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketModelList"
                }
              }
            }
          },
          "400": {
            "description": "Query parameters are not supported.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "pricing.v1.json#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "A live user browser session is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "pricing.v1.json#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Current content authority has been withdrawn.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "pricing.v1.json#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "The development meter is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "pricing.v1.json#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "UserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-orange-user"
      }
    },
    "schemas": {
      "ReviewedTextModel": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "modality": {
            "const": "text"
          },
          "model_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "model_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "context_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "max_request_bytes": {
            "const": 262144
          },
          "offers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "pricing.v1.json#/components/schemas/TextPriceView"
            }
          }
        },
        "required": [
          "modality",
          "model_version",
          "model_sha256",
          "repository",
          "revision",
          "license",
          "context_tokens",
          "max_request_bytes",
          "offers"
        ]
      },
      "MarketModelList": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReviewedTextModel"
            },
            "maxItems": 1
          }
        },
        "required": [
          "data"
        ]
      }
    }
  }
}
