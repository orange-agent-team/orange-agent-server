{
  "openapi": "3.1.0",
  "info": {
    "title": "Orange private artifact API",
    "version": "0.1.0",
    "description": "Personal/org current sessions and independent content ACL. No Worker delivery or output settlement permission. Object IO outside DB transactions; publication and each output batch reauthorize. Opaque data is not MIME-decoder certification."
  },
  "paths": {
    "/api/v1/owners/{owner}/uploads": {
      "post": {
        "operationId": "createArtifactUpload",
        "security": [
          {
            "UserSession": []
          }
        ],
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "description": "Must exactly equal the upload_id in the body or path. Owner and operation define its scope."
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactView"
                }
              }
            }
          },
          "default": {
            "description": "Current authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUpload"
              }
            }
          }
        }
      }
    },
    "/api/v1/owners/{owner}/uploads/{upload}": {
      "get": {
        "operationId": "artifactUploadStatus",
        "security": [
          {
            "UserSession": []
          }
        ],
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          {
            "name": "upload",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactView"
                }
              }
            }
          },
          "default": {
            "description": "Current authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteArtifact",
        "security": [
          {
            "UserSession": []
          }
        ],
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          {
            "name": "upload",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "description": "Must exactly equal the upload_id in the body or path. Owner and operation define its scope."
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactView"
                }
              }
            }
          },
          "default": {
            "description": "Current authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/owners/{owner}/uploads/{upload}/content": {
      "put": {
        "operationId": "putArtifactBytes",
        "security": [
          {
            "UserSession": []
          }
        ],
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          {
            "name": "upload",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "description": "Must exactly equal the upload_id in the body or path. Owner and operation define its scope."
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactView"
                }
              }
            }
          },
          "default": {
            "description": "Current authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary",
                "maxLength": 104857600
              }
            }
          }
        },
        "description": "Stream exact declared bytes within5min. Same-ID different bytes fail. Request loss queries original status; no automatic new upload ID."
      },
      "get": {
        "operationId": "readArtifactVersion",
        "security": [
          {
            "UserSession": []
          }
        ],
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          {
            "name": "upload",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          {
            "name": "version_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded immutable bytes; verify ETag SHA256 and full Content-Length. A failed/revoked midstream response is incomplete, never a successful partial object.",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              },
              "Content-Length": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary",
                  "maxLength": 104857600
                }
              }
            }
          },
          "default": {
            "description": "Current authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "UserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-orange-user"
      }
    },
    "schemas": {
      "CreateUpload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "upload_id",
          "sha256",
          "size_bytes",
          "media_type"
        ],
        "properties": {
          "upload_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,7}|10[0-3][0-9]{6}|104[0-7][0-9]{5}|1048[0-4][0-9]{4}|10485[0-6][0-9]{3}|104857[0-5][0-9]{2}|104857600)$",
            "description": "Canonical decimal byte length; maximum104857600. Declared media maximum100000000."
          },
          "media_type": {
            "type": "string",
            "enum": [
              "application/octet-stream",
              "application/json",
              "text/plain",
              "image/png",
              "image/jpeg",
              "image/webp",
              "audio/wav",
              "audio/mpeg",
              "audio/flac",
              "audio/ogg",
              "video/mp4"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "media_type": {
                  "enum": [
                    "image/png",
                    "image/jpeg",
                    "image/webp",
                    "audio/wav",
                    "audio/mpeg",
                    "audio/flac",
                    "audio/ogg",
                    "video/mp4"
                  ]
                }
              },
              "required": [
                "media_type"
              ]
            },
            "then": {
              "properties": {
                "size_bytes": {
                  "pattern": "^(0|[1-9][0-9]{0,7}|100000000)$"
                }
              }
            }
          }
        ]
      },
      "ArtifactView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "upload_id",
          "sha256",
          "size_bytes",
          "media_type",
          "artifact_id",
          "version_id",
          "owner_id",
          "state"
        ],
        "properties": {
          "upload_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,7}|10[0-3][0-9]{6}|104[0-7][0-9]{5}|1048[0-4][0-9]{4}|10485[0-6][0-9]{3}|104857[0-5][0-9]{2}|104857600)$",
            "description": "Canonical decimal byte length; maximum104857600. Declared media maximum100000000."
          },
          "media_type": {
            "type": "string",
            "enum": [
              "application/octet-stream",
              "application/json",
              "text/plain",
              "image/png",
              "image/jpeg",
              "image/webp",
              "audio/wav",
              "audio/mpeg",
              "audio/flac",
              "audio/ogg",
              "video/mp4"
            ]
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "version_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "owner_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "state": {
            "type": "string",
            "enum": [
              "staging",
              "available",
              "deleted"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "media_type": {
                  "enum": [
                    "image/png",
                    "image/jpeg",
                    "image/webp",
                    "audio/wav",
                    "audio/mpeg",
                    "audio/flac",
                    "audio/ogg",
                    "video/mp4"
                  ]
                }
              },
              "required": [
                "media_type"
              ]
            },
            "then": {
              "properties": {
                "size_bytes": {
                  "pattern": "^(0|[1-9][0-9]{0,7}|100000000)$"
                }
              }
            }
          }
        ]
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "request_id",
          "retry_class"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "retry_class": {
            "type": "string"
          }
        }
      }
    }
  }
}
